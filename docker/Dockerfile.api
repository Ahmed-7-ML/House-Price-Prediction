FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy project metadata first for better caching
COPY pyproject.toml README.md ./
COPY src/ src/

# Install dependencies (no dev)
RUN uv sync --no-dev --no-install-project
RUN uv pip install --system -e .

# Copy remaining artifacts (model will be mounted or copied at build time)
COPY configs/ configs/
COPY models/ models/

ENV PYTHONPATH=/app/src
ENV HP_MLFLOW_TRACKING_URI=/app/mlruns

EXPOSE 8000

CMD ["uvicorn", "house_price_mlops.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
